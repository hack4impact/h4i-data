{
  "name": "volunteer-management-backend",
  "version": "1.0.0",
  "description": "Backend API for volunteer management with GraphQL and REST endpoints",
  "main": "src/app.ts",
  "scripts": {
    "dev": "ts-node src/app.ts",
    "dev:graphql": "ts-node src/graphql/server.ts",
    "dev:rest": "ts-node src/rest/server.ts",
    "dev:both": "concurrently \"npm run dev:graphql\" \"npm run dev:rest\"",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "npx prisma generate && jest --runInBand",
    "test:watch": "jest --watch",
    "prisma:generate": "npx prisma generate",
    "prisma:pull": "npx prisma db pull",
    "prisma:sync": "npm run prisma:pull && npm run prisma:generate",
    "seed": "SEED_DATA=true ts-node src/app.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack4impact/test-backend.git"
  },
  "keywords": [
    "graphql",
    "rest-api",
    "volunteers",
    "typescript",
    "prisma",
    "supabase"
  ],
  "author": "Hack4Impact",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/hack4impact/test-backend/issues"
  },
  "homepage": "https://github.com/hack4impact/test-backend#readme",
  "dependencies": {
    "@graphql-tools/schema": "^10.0.23",
    "@prisma/client": "^6.14.0",
    "@supabase/supabase-js": "^2.49.4",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-graphql": "^0.12.0",
    "graphql-iso-date": "^3.6.1",
    "pg": "^8.15.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/graphql-iso-date": "^3.4.3",
    "@types/jest": "^29.5.14",
    "@types/pg": "^8.11.14",
    "concurrently": "^9.1.0",
    "jest": "^29.7.0",
    "prisma": "^6.14.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
