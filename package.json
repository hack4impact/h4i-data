{
  "name": "volunteer-management-backend",
  "version": "1.0.0",
  "description": "Backend API for volunteer management with GraphQL and REST endpoints",
  "main": "src/app.ts",
  "scripts": {
    "dev": "ts-node src/app.ts",
    "dev:both": "concurrently \"npm run dev:graphql\" \"npm run dev:rest\"",
    "dev:graphql": "ts-node src/api/graphql/server.ts",
    "dev:rest": "ts-node src/api/rest/server.ts",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage",
    "test:integration": "cross-env NODE_ENV=test jest --testMatch=\"**/tests/integration/**/*.test.ts\" --runInBand",
    "test:unit": "jest tests/unit",
    "test:watch": "jest --watch tests/unit",
    "prepare": "husky",
    "build": "tsc",
    "start": "node dist/app.js",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write src/",
    "type-check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack4impact/test-backend.git"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "graphql",
    "rest-api",
    "volunteers",
    "typescript",
    "prisma",
    "supabase"
  ],
  "author": "Hack4Impact",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hack4impact/test-backend/issues"
  },
  "homepage": "https://github.com/hack4impact/test-backend#readme",
  "dependencies": {
    "@graphql-tools/schema": "^10.0.23",
    "@prisma/client": "^6.15.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-graphql": "^0.12.0",
    "express-rate-limit": "^8.1.0",
    "graphql-scalars": "^1.24.2",
    "helmet": "^8.1.0",
    "pg": "^8.15.6",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.11.14",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.1.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.1.5",
    "prettier": "3.6.2",
    "prisma": "^6.15.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "zod": "^4.1.5"
  }
}
