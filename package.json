{
  "name": "operations-api",
  "version": "1.0.0",
  "packageManager": "pnpm@10.28.2",
  "description": "Backend API for H4I operations with GraphQL and REST endpoints",
  "main": "src/app.ts",
  "scripts": {
    "build": "tsc && prisma generate",
    "dev": "ts-node src/app.ts",
    "dev:both": "concurrently \"pnpm run dev:graphql\" \"pnpm run dev:rest\"",
    "dev:graphql": "ts-node src/api/graphql/server.ts",
    "dev:rest": "ts-node src/api/rest/server.ts",
    "format": "prettier --write src/",
    "lint": "eslint src/ --ext .ts",
    "prepare": "husky",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down -v",
    "seed:test": "docker compose exec -T test-db psql -U postgres -d test_db -f /docker-entrypoint-initdb.d/seed.sql",
    "start": "node dist/app.js",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:coverage": "jest --coverage --testPathIgnorePatterns=tests/integration",
    "test:integration": "cross-env NODE_ENV=test jest --config jest.config.integration.ts --runInBand",
    "test:unit": "jest tests/unit",
    "test:watch": "jest --watch tests/unit",
    "type-check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack4impact/operations-api.git"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "graphql",
    "rest-api",
    "volunteers",
    "typescript",
    "prisma",
    "supabase"
  ],
  "author": "Hack4Impact",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hack4impact/operations-api/issues"
  },
  "homepage": "https://github.com/hack4impact/operations-api#readme",
  "dependencies": {
    "@graphql-tools/schema": "^10.0.31",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "graphql": "^16.13.1",
    "graphql-http": "^1.22.4",
    "graphql-scalars": "^1.25.0",
    "helmet": "^8.1.0",
    "pg": "^8.20.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^7.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.3.3",
    "prettier": "3.8.1",
    "prisma": "^7.4.2",
    "prisma-dbml-generator": "^0.12.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "zod": "^4.3.6"
  }
}
