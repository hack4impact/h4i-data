{
  "name": "volunteer-management-backend",
  "version": "1.0.0",
  "description": "Backend API for volunteer management with GraphQL and REST endpoints",
  "main": "src/app.ts",
  "scripts": {
    "build": "tsc && prisma generate",
    "dev": "ts-node src/app.ts",
    "dev:both": "concurrently \"npm run dev:graphql\" \"npm run dev:rest\"",
    "dev:graphql": "ts-node src/api/graphql/server.ts",
    "dev:rest": "ts-node src/api/rest/server.ts",
    "format": "prettier --write src/",
    "lint": "eslint src/ --ext .ts",
    "prepare": "husky",
    "seed:test": "docker compose exec -T test-db psql -U postgres -d test_db -f /docker-entrypoint-initdb.d/seed.sql",
    "start": "node dist/app.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:coverage": "jest --coverage --testPathIgnorePatterns=tests/integration",
    "test:integration": "cross-env NODE_ENV=test jest tests/integration --runInBand",
    "test:unit": "jest tests/unit",
    "test:watch": "jest --watch tests/unit",
    "type-check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack4impact/test-backend.git"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "graphql",
    "rest-api",
    "volunteers",
    "typescript",
    "prisma",
    "supabase"
  ],
  "author": "Hack4Impact",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hack4impact/test-backend/issues"
  },
  "homepage": "https://github.com/hack4impact/test-backend#readme",
  "dependencies": {
    "@graphql-tools/schema": "^10.0.31",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "graphql": "^16.12.0",
    "graphql-http": "^1.22.4",
    "graphql-scalars": "^1.25.0",
    "helmet": "^8.1.0",
    "pg": "^8.18.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "prettier": "3.8.1",
    "prisma": "^7.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "zod": "^4.3.6"
  }
}
