{
  "name": "volunteer-management-backend",
  "version": "1.0.0",
  "description": "Backend API for volunteer management with GraphQL and REST endpoints",
  "main": "src/app.ts",
  "scripts": {
    "dev": "ts-node src/app.ts",
    "dev:both": "concurrently \"npm run dev:graphql\" \"npm run dev:rest\"",
    "dev:graphql": "ts-node src/graphql/server.ts",
    "dev:rest": "ts-node src/rest/server.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:integration": "jest tests/integration",
    "test:unit": "jest tests/unit",
    "test:watch": "jest --watch tests/unit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack4impact/test-backend.git"
  },
  "keywords": [
    "graphql",
    "rest-api",
    "volunteers",
    "typescript",
    "prisma",
    "supabase"
  ],
  "author": "Hack4Impact",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hack4impact/test-backend/issues"
  },
  "homepage": "https://github.com/hack4impact/test-backend#readme",
  "dependencies": {
    "@graphql-tools/schema": "^10.0.23",
    "@prisma/client": "^6.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-graphql": "^0.12.0",
    "graphql-scalars": "^1.24.2",
    "pg": "^8.15.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.11.14",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.1.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "3.6.2",
    "prisma": "^6.14.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
