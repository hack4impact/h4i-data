generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model chapters {
  chapter_id                String                      @id(map: "chapter_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                      String
  location_id               String?                     @db.Uuid
  founded_date              DateTime                    @db.Date
  status_type               status_type                 @default(ACTIVE)
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @default(now()) @db.Timestamptz(6)
  locations                 locations?                  @relation(fields: [location_id], references: [location_id], onDelete: NoAction, onUpdate: NoAction)
  nonprofit_chapter_project nonprofit_chapter_project[]
  sponsor_chapter           sponsor_chapter[]
  volunteers                volunteers[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model companies {
  company_id  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  location_id String?       @db.Uuid
  locations   locations?    @relation(fields: [location_id], references: [location_id], onDelete: NoAction, onUpdate: NoAction)
  connections connections[]
  sponsors    sponsors[]
  volunteers  volunteers[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model connections {
  volunteer_id   String    @id @db.Uuid
  company_id     String    @db.Uuid
  graduated_year DateTime  @db.Date
  university_id  String    @db.Uuid
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)
  companies      companies @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction)
  locations      locations @relation(fields: [university_id], references: [location_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model contacts {
  contact_id                                                                       String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                                                             String
  email                                                                            String
  phone_number                                                                     String?
  created_at                                                                       DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                                                                       DateTime                    @default(now()) @db.Timestamptz(6)
  nonprofit_chapter_project_nonprofit_chapter_project_collab_contact_idTocontacts  nonprofit_chapter_project[] @relation("nonprofit_chapter_project_collab_contact_idTocontacts")
  nonprofit_chapter_project_nonprofit_chapter_project_project_contact_idTocontacts nonprofit_chapter_project[] @relation("nonprofit_chapter_project_project_contact_idTocontacts")
  nonprofits                                                                       nonprofits[]
  sponsors                                                                         sponsors[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model locations {
  location_id      String        @id(map: "university_pkey1") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  address          String
  country_code     String        @default("US") @db.Char(2)
  subdivision_code String
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime      @default(now()) @db.Timestamptz(6)
  chapters         chapters[]
  companies        companies[]
  connections      connections[]
  nonprofits       nonprofits[]
  sponsors         sponsors[]
  volunteers       volunteers[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model national_branches {
  branch_id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  volunteer_assignment volunteer_assignment[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model nonprofit_chapter_project {
  nonprofit_chapter_project_id                                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nonprofit_id                                                    String      @db.Uuid
  chapter_id                                                      String?     @db.Uuid
  project_id                                                      String      @db.Uuid
  project_contact_id                                              String      @db.Uuid
  collab_contact_id                                               String      @db.Uuid
  start_date                                                      DateTime    @db.Date
  end_date                                                        DateTime?   @db.Date
  notes                                                           String?
  project_status                                                  status_type @default(ACTIVE)
  created_at                                                      DateTime    @default(now()) @db.Timestamptz(6)
  updated_at                                                      DateTime    @default(now()) @db.Timestamptz(6)
  chapters                                                        chapters?   @relation(fields: [chapter_id], references: [chapter_id], onDelete: NoAction, onUpdate: NoAction)
  contacts_nonprofit_chapter_project_collab_contact_idTocontacts  contacts    @relation("nonprofit_chapter_project_collab_contact_idTocontacts", fields: [collab_contact_id], references: [contact_id], onDelete: NoAction, onUpdate: NoAction)
  nonprofits                                                      nonprofits  @relation(fields: [nonprofit_id], references: [nonprofit_id], onDelete: NoAction, onUpdate: NoAction)
  contacts_nonprofit_chapter_project_project_contact_idTocontacts contacts    @relation("nonprofit_chapter_project_project_contact_idTocontacts", fields: [project_contact_id], references: [contact_id], onDelete: NoAction, onUpdate: NoAction)
  projects                                                        projects    @relation(fields: [project_id], references: [project_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model nonprofits {
  nonprofit_id              String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                      String
  mission                   String
  website                   String?
  location_id               String?                     @db.Uuid
  contact_id                String                      @db.Uuid
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @default(now()) @db.Timestamptz(6)
  nonprofit_chapter_project nonprofit_chapter_project[]
  contacts                  contacts                    @relation(fields: [contact_id], references: [contact_id], onDelete: NoAction, onUpdate: NoAction)
  locations                 locations?                  @relation(fields: [location_id], references: [location_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model projects {
  project_id                String                      @id(map: "project_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                      String
  description               String?
  budget                    Decimal?                    @db.Decimal(12, 2)
  repo                      String
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @default(now()) @db.Timestamptz(6)
  nonprofit_chapter_project nonprofit_chapter_project[]
  volunteer_role_project    volunteer_role_project[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model roles {
  role_id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  description            String
  permissions            Json
  level_type             level_type               @default(REGULAR_CHAPTER_VOLUNTEER_LEVEL)
  volunteer_assignment   volunteer_assignment[]
  volunteer_role_project volunteer_role_project[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sponsor_chapter {
  sponsor_chapter_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sponsor_id         String    @db.Uuid
  chapter_id         String?   @db.Uuid
  year_sponsored     DateTime  @db.Date
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_date       DateTime  @default(now()) @db.Timestamptz(6)
  chapters           chapters? @relation(fields: [chapter_id], references: [chapter_id], onDelete: NoAction, onUpdate: NoAction)
  sponsors           sponsors  @relation(fields: [sponsor_id], references: [sponsor_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sponsors {
  sponsor_id      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  location_id     String?           @db.Uuid
  contact_id      String            @db.Uuid
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_date    DateTime          @default(now()) @db.Timestamptz(6)
  company_id      String?           @db.Uuid
  sponsor_chapter sponsor_chapter[]
  companies       companies?        @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction)
  contacts        contacts          @relation(fields: [contact_id], references: [contact_id], onDelete: NoAction, onUpdate: NoAction)
  locations       locations?        @relation(fields: [location_id], references: [location_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model volunteer_assignment {
  volunteer_assignment_id String             @id(map: "member_assignment_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  volunteer_id            String             @db.Uuid
  role_id                 String             @db.Uuid
  branch_id               String?            @db.Uuid
  start_date              DateTime           @db.Date
  end_date                DateTime           @db.Date
  status                  status_type        @default(ACTIVE)
  created_at              DateTime           @default(now()) @db.Timestamptz(6)
  updated_at              DateTime           @default(now()) @db.Timestamptz(6)
  national_branches       national_branches? @relation(fields: [branch_id], references: [branch_id], onDelete: NoAction, onUpdate: NoAction, map: "member_assignment_branch_id_fkey")
  roles                   roles              @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction, map: "member_assignment_role_id_fkey")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model volunteer_history {
  history_id   String      @id(map: "membership_history_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  volunteer_id String      @db.Uuid
  action_type  action_type @default(JOINED)
  reason       String?
  action_date  DateTime    @db.Date
  created_at   DateTime    @default(now()) @db.Timestamptz(6)
  updated_at   DateTime    @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model volunteer_role_project {
  volunteer_role_project_id String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  volunteer_id              String     @db.Uuid
  role_id                   String     @db.Uuid
  project_id                String     @db.Uuid
  start_date                DateTime   @db.Date
  end_date                  DateTime?  @db.Date
  notes                     String?
  created_at                DateTime   @default(now()) @db.Timestamptz(6)
  updated_at                DateTime   @default(now()) @db.Timestamptz(6)
  projects                  projects   @relation(fields: [project_id], references: [project_id], onDelete: NoAction, onUpdate: NoAction, map: "member_role_project_id_fkey")
  roles                     roles      @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction, map: "member_role_role_id_fkey")
  volunteers                volunteers @relation(fields: [volunteer_id], references: [volunteer_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model volunteers {
  volunteer_id           String                   @id(map: "members_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  first_name             String
  last_name              String
  email                  String                   @unique(map: "person_email_key")
  graduation_date        DateTime                 @db.Date
  university_id          String                   @db.Uuid
  volunteer_status       volunteer_status         @default(STUDENT)
  H4I_email              String?
  chapter_id             String?                  @db.Uuid
  volunteer_type         volunteer_type           @default(CHAPTER)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  company_id             String?                  @db.Uuid
  volunteer_role_project volunteer_role_project[]
  chapters               chapters?                @relation(fields: [chapter_id], references: [chapter_id], onDelete: NoAction, onUpdate: NoAction, map: "members_chapter_id_fkey")
  companies              companies?               @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction)
  locations              locations                @relation(fields: [university_id], references: [location_id], onDelete: NoAction, onUpdate: NoAction)
}

