# Database Configuration (connects via connection pooling)
SUPABASE_URL=your_supabase_connection_string_here
DATABASE_URL=your_database_url_here
DIRECT_URL=your_direct_url_here

# Database Connection Pool Settings (optional - Prisma defaults are good)
DB_CONNECTION_LIMIT=10
DB_POOL_TIMEOUT=30000

# Server Configuration
PORT=3001
REST_PORT=3002
GRAPHQL_PORT=3003

# Application Configuration
NODE_ENV=development
SEED_DATA=false

# Security Configuration
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://staging.yourdomain.com

# Optional: Add any API keys or other configuration
# JWT_SECRET=your_jwt_secret_here
