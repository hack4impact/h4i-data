# Use a separate database for testing to avoid wiping your development data.
# Make sure this database exists on your PostgreSQL server.
DATABASE_URL="postgresql://youruser:yourpassword@localhost:5432/your_test_db?schema=public"

# These ports can be the same as in your main .env because
# the test runner will control the server lifecycle.
PORT=4000
REST_PORT=4001
GRAPHQL_PORT=4002
NODE_ENV=test
