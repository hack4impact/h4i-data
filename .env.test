# Database Configuration (connects via connection pooling)
SUPABASE_URL=your_supabase_connection_string_here
DATABASE_URL=your_database_url_here
DIRECT_URL=your_direct_url_here

# Server Configuration (using different ports for testing)
PORT=4001
REST_PORT=4002
GRAPHQL_PORT=4003

# Application Configuration
NODE_ENV=development
SEED_DATA=false

# Optional: Add any API keys or other configuration
# JWT_SECRET=your_jwt_secret_here
# CORS_ORIGIN=http://localhost:3000
